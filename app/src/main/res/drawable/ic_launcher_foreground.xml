        android:pathData="M51,55 L51,52 C51,50.34 52.34,49 54,49 C55.66,49 57,52 57,52 L57,55"
        android:strokeWidth="1.8"
        android:strokeColor="#00E5FF"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Padlock Body -->
    <path
        android:pathData="M49,55 C48.45,55 48,55.45 48,56 L48,63 C48,63.55 48.45,64 49,64 L59,64 C59.55,64 60,63.55 60,63 L60,56 C60,55.45 59.55,55 59,55 Z"
        android:fillColor="#00E5FF" />

    <!-- Keyhole -->
    <path
        android:pathData="M54,58 A1,1 0 1 0 54,60 A1,1 0 1 0 54,58 Z"
        android:fillColor="#0B132B" />
</vector>
