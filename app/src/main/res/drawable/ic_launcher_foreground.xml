<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Rounded Gallery Picture Frame (Safe zone centered around 54,54) -->
    <path
        android:pathData="M33,32 C33,28.69 35.69,26 39,26 L69,26 C72.31,26 75,28.69 75,32 L75,76 C75,79.31 72.31,82 69,82 L39,82 C35.69,82 33,79.31 33,76 Z"
        android:strokeWidth="2.5"
        android:strokeColor="#38BDF8"
        android:fillColor="#151E2E" />

    <!-- Mountain Landscape representation inside photo frame -->
    <path
        android:pathData="M35,68 L47,53 L56,64 L63,55 L73,68 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="50"
                android:endX="54"
                android:endY="68"
                android:type="linear">
                <item android:offset="0.0" android:color="#22D3EE" />
                <item android:offset="1.0" android:color="#0284C7" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sun / Aperture in top right of photo -->
    <path
        android:pathData="M44,38 A4,4 0 1 0 44,46 A4,4 0 1 0 44,38 Z"
        android:fillColor="#38BDF8" />

    <!-- Central Security Shield Badge -->
    <path
        android:pathData="M54,44 L67,49 C67,61 54,71 54,71 C54,71 41,61 41,49 Z"
        android:strokeWidth="2"
        android:strokeColor="#00E5FF"
        android:fillColor="#0B132B" />

